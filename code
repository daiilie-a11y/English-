            isStoryPlaying = false;
            isStoryPaused = false;
            currentSentenceIdx = 0;
            highlightStorySentence(-1);
            updateStoryUIState();
        }

        function highlightStorySentence(activeIdx) {
            const word = wordDatabase[currentWordIndex];
            word.storySentences.forEach((_, idx) => {
                const el = document.getElementById(`story-sent-${idx}`);
                if (el) {
                    if (idx === activeIdx) {
                        el.classList.add('active-sentence');
                    } else {
                        el.classList.remove('active-sentence');
                    }
                }
            });
        }

        function updateStoryUIState() {
            const playBtn = document.getElementById('story-play-btn');
            const pauseBtn = document.getElementById('story-pause-btn');

            if (isStoryPlaying && !isStoryPaused) {
                playBtn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> 朗讀中...`;
                playBtn.classList.remove('from-purple-600', 'to-indigo-600');
                playBtn.classList.add('from-purple-700', 'to-indigo-800');
                pauseBtn.classList.remove('hidden');
            } else if (isStoryPaused) {
                playBtn.innerHTML = `<i class="fa-solid fa-play"></i> 繼續朗讀`;
                pauseBtn.classList.add('hidden');
            } else {
                playBtn.innerHTML = `<i class="fa-solid fa-play"></i> 播放故事朗讀`;
                playBtn.classList.add('from-purple-600', 'to-indigo-600');
                pauseBtn.classList.add('hidden');
            }
        }

        function reloadVideo() {
            const word = wordDatabase[currentWordIndex];
            document.getElementById('youtube-player').src = `https://www.youtube.com/embed/${word.youtubeId}?autoplay=1`;
        }

        // Bookmarks Management
        function toggleCurrentWordBookmark() {
            const currentWord = wordDatabase[currentWordIndex].word;
            toggleBookmark(currentWord);
        }

        function toggleBookmark(wordName) {
            const index = bookmarkedWords.indexOf(wordName);
            if (index > -1) {
                bookmarkedWords.splice(index, 1);
                showToast(`已移除收藏「${wordName}」`);
            } else {
                bookmarkedWords.push(wordName);
                showToast(`成功收藏「${wordName}」！`);
            }
            localStorage.setItem('wordwave_v2_bookmarks', JSON.stringify(bookmarkedWords));
            updateBookmarkButtonState(wordDatabase[currentWordIndex].word);
            renderExploreGrid(wordDatabase);
            renderCollectionGrid();
        }

        function updateBookmarkButtonState(wordName) {
            const btn = document.getElementById('daily-bookmark-btn');
            if (bookmarkedWords.includes(wordName)) {
                btn.innerHTML = '<i class="fa-solid fa-bookmark text-purple-400"></i>';
                btn.classList.add('bg-purple-600/30');
            } else {
                btn.innerHTML = '<i class="fa-regular fa-bookmark"></i>';
                btn.classList.remove('bg-purple-600/30');
            }
        }

        // Explore Grid & Filter
        function filterByCategory(category) {
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.classList.remove('bg-purple-600', 'text-white');
                btn.classList.add('bg-slate-800', 'text-slate-300');
            });
            event.target.classList.remove('bg-slate-800', 'text-slate-300');
            event.target.classList.add('bg-purple-600', 'text-white');

            let filtered = wordDatabase;
            if (category !== 'all') {
                filtered = wordDatabase.filter(w => w.category === category);
            }
            renderExploreGrid(filtered);
        }

        function filterWords() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const filtered = wordDatabase.filter(w => 
                w.word.toLowerCase().includes(query) || 
                w.translation.toLowerCase().includes(query) ||
                w.category.toLowerCase().includes(query)
            );
            renderExploreGrid(filtered);
        }

        function renderExploreGrid(words) {
            const grid = document.getElementById('explore-word-grid');
            if (words.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-500">找不到符合的單字</div>`;
                return;
            }

            grid.innerHTML = words.map(w => {
                const isBookmarked = bookmarkedWords.includes(w.word);
                return `
                    <div class="glass-panel rounded-2xl p-4 border border-slate-800 flex flex-col justify-between hover:border-purple-500/40 transition">
                        <div>
                            <div class="relative h-32 rounded-xl overflow-hidden mb-3">
                                <img src="${w.imageUrl}" class="w-full h-full object-cover">
                                <span class="absolute top-2 left-2 text-[10px] font-bold bg-slate-950/80 text-purple-300 px-2 py-0.5 rounded-full border border-purple-500/30">${w.category}</span>
                                <button onclick="toggleBookmark('${w.word}')" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-slate-900/80 text-white flex items-center justify-center">
                                    <i class="${isBookmarked ? 'fa-solid text-purple-400' : 'fa-regular'} fa-bookmark text-xs"></i>
                                </button>
                            </div>
                            <div class="flex items-center justify-between mb-1">
                                <h4 class="text-lg font-bold text-white">${w.word}</h4>
                                <button onclick="speakWord('${w.word}')" class="text-purple-400 p-1">
                                    <i class="fa-solid fa-volume-high text-xs"></i>
                                </button>
                            </div>
                            <p class="text-xs text-purple-300 font-semibold mb-1">${w.translation}</p>
                            <p class="text-[11px] text-slate-400 line-clamp-2">${w.definition}</p>
                        </div>
                        <button onclick='loadWordDirectly("${w.word}")' class="mt-4 w-full py-2 bg-slate-800 hover:bg-purple-600 hover:text-white text-purple-300 text-xs font-bold rounded-xl transition">
                            開始沉浸洗腦
                        </button>
                    </div>
                `;
            }).join('');
        }

        function loadWordDirectly(wordName) {
            const index = wordDatabase.findIndex(w => w.word === wordName);
            if (index !== -1) {
                loadDailyWordByIndex(index);
                switchTab('daily');
                startBrainwashSession();
            }
        }

        // Custom Theme Generator
        function setCustomThemeQuery(topic) {
            document.getElementById('custom-theme-input').value = topic;
            generateCustomTheme();
        }

        function generateCustomTheme() {
            const input = document.getElementById('custom-theme-input').value.trim();
            if (!input) {
                showToast('請輸入主題！');
                return;
            }

            const container = document.getElementById('custom-result-container');
            const listContainer = document.getElementById('custom-word-cards-list');
            document.getElementById('custom-theme-badge').textContent = `主題：${input}`;
            container.classList.remove('hidden');

            const generatedWords = [
                {
                    word: input.includes('健身') ? "Hypertrophy" : (input.includes('咖啡') ? "Aroma" : "Apex"),
                    phonetic: "/haɪˈpɜː.trə.fi/",
                    pos: "noun (名詞)",
                    translation: "肌肉肥大、增肌",
                    definition: `Customized key concept for ${input}.`,
                    imageUrl: "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=800&q=80",
                    category: input
                },
                {
                    word: input.includes('健身') ? "Endurance" : "Synergy",
                    phonetic: "/ɪnˈdʊr.əns/",
                    pos: "noun (名詞)",
                    translation: "耐力、持久力",
                    definition: `High-frequency vocabulary item generated for ${input}.`,
                    imageUrl: "https://images.unsplash.com/photo-1486218119243-13883505764c?auto=format&fit=crop&w=800&q=80",
                    category: input
                }
            ];

            listContainer.innerHTML = generatedWords.map(w => `
                <div class="glass-panel rounded-2xl p-4 border border-purple-500/30 flex flex-col justify-between">
                    <div>
                        <div class="h-28 rounded-xl overflow-hidden mb-2">
                            <img src="${w.imageUrl}" class="w-full h-full object-cover">
                        </div>
                        <h4 class="text-base font-bold text-white">${w.word} <span class="text-xs font-mono text-slate-400">${w.phonetic}</span></h4>
                        <p class="text-xs text-purple-300 font-bold mb-1">${w.translation}</p>
                        <p class="text-[11px] text-slate-400 mb-2">${w.definition}</p>
                    </div>
                    <button onclick='showToast("已成功載入主題單字！")' class="w-full py-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold rounded-xl transition">
                        體驗主題洗腦
                    </button>
                </div>
            `).join('');

            showToast(`已生成「${input}」主題洗腦包！`);
        }

        // Collection Render
        function renderCollectionGrid() {
            const grid = document.getElementById('collection-word-grid');
            const savedWords = wordDatabase.filter(w => bookmarkedWords.includes(w.word));

            if (savedWords.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-500 glass-panel rounded-3xl">
                        <i class="fa-regular fa-bookmark text-3xl mb-2 text-purple-400"></i>
                        <p class="text-xs">尚未收藏任何單字，點擊書籤圖示即可加入收藏！</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = savedWords.map(w => `
                <div class="glass-panel rounded-2xl p-4 border border-slate-800 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[10px] font-bold bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full border border-purple-500/30">${w.category}</span>
                            <button onclick="toggleBookmark('${w.word}')" class="text-purple-400">
                                <i class="fa-solid fa-bookmark text-xs"></i>
                            </button>
                        </div>
                        <h4 class="text-lg font-bold text-white mb-0.5">${w.word}</h4>
                        <p class="text-xs text-purple-300 font-semibold mb-2">${w.translation}</p>
                        <p class="text-[11px] text-slate-400 line-clamp-2">${w.definition}</p>
                    </div>
                    <button onclick='loadWordDirectly("${w.word}")' class="mt-4 w-full py-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold rounded-xl transition">
                        複習洗腦 <i class="fa-solid fa-play ml-1"></i>
                    </button>
                </div>
            `).join('');
        }

        // Upgraded 5-Stage Brainwash Engine
        function startBrainwashSession() {
            stopStoryTTS();
            activeWordObj = wordDatabase[currentWordIndex];
            currentBrainwashStep = 1;
            document.getElementById('modal-brainwash-title').textContent = `1分鐘五感洗腦: ${activeWordObj.word}`;
            document.getElementById('brainwash-modal').classList.remove('hidden');
            renderBrainwashStep();
        }

        function closeBrainwashSession() {
            document.getElementById('brainwash-modal').classList.add('hidden');
        }

        function nextBrainwashStep() {
            if (currentBrainwashStep < 5) {
                currentBrainwashStep++;
                renderBrainwashStep();
            } else {
                closeBrainwashSession();
            }
        }

        function prevBrainwashStep() {
            if (currentBrainwashStep > 1) {
                currentBrainwashStep--;
                renderBrainwashStep();
            }
        }

        function renderBrainwashStep() {
            const container = document.getElementById('brainwash-steps-container');
            const progressBar = document.getElementById('brainwash-progress-bar');
            const stepIndicator = document.getElementById('brainwash-step-indicator');
            const prevBtn = document.getElementById('brainwash-prev-btn');
            const nextBtn = document.getElementById('brainwash-next-btn');

            progressBar.style.width = `${(currentBrainwashStep / 5) * 100}%`;
            stepIndicator.textContent = `階段 ${currentBrainwashStep} / 5`;
            prevBtn.disabled = currentBrainwashStep === 1;

            if (currentBrainwashStep === 1) {
                nextBtn.innerHTML = `下一步 <i class="fa-solid fa-chevron-right ml-1"></i>`;
                speakWord(activeWordObj.word);
                container.innerHTML = `
                    <div class="space-y-3 text-center">
                        <span class="text-[10px] font-mono font-bold bg-purple-500/20 text-purple-300 px-3 py-1 rounded-full border border-purple-500/30 uppercase">Stage 1: 視覺情境與標準發音</span>
                        <div class="relative h-48 rounded-2xl overflow-hidden border border-slate-700 my-2">
                            <img src="${activeWordObj.imageUrl}" class="w-full h-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
                            <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between">
                                <h4 class="text-3xl font-black text-white">${activeWordObj.word}</h4>
                                <button onclick="speakWord('${activeWordObj.word}')" class="w-10 h-10 rounded-full bg-purple-600 text-white flex items-center justify-center">
                                    <i class="fa-solid fa-volume-high"></i>
                                </button>
                            </div>
                        </div>
                        <p class="text-xs text-slate-300 font-semibold">${activeWordObj.translation} · ${activeWordObj.phonetic}</p>
                    </div>
                `;
            } else if (currentBrainwashStep === 2) {
                nextBtn.innerHTML = `下一步 <i class="fa-solid fa-chevron-right ml-1"></i>`;
                speakWord(activeWordObj.mnemonic.hook);
                container.innerHTML = `
                    <div class="space-y-4">
                        <div class="bg-amber-500/10 p-4 rounded-2xl border border-amber-500/30">
                            <span class="text-[10px] font-bold text-amber-400 uppercase">Stage 2: 記憶藍圖與諧音聯想</span>
                            <h4 class="text-lg font-extrabold text-amber-300 mt-1">${activeWordObj.mnemonic.hook}</h4>
                        </div>
                        <div class="space-y-2 text-xs text-slate-300 bg-slate-950 p-4 rounded-2xl border border-slate-800">
                            <p><strong>諧音/拆解：</strong> ${activeWordObj.mnemonic.root}</p>
                            <p><strong>圖像畫面：</strong> ${activeWordObj.mnemonic.image}</p>
                        </div>
                    </div>
                `;
            } else if (currentBrainwashStep === 3) {
                nextBtn.innerHTML = `下一步 <i class="fa-solid fa-chevron-right ml-1"></i>`;
                speakWord(activeWordObj.storySentences.join(' '));
                container.innerHTML = `
                    <div class="space-y-3">
                        <span class="text-[10px] font-bold bg-indigo-500/20 text-indigo-300 px-3 py-1 rounded-full border border-indigo-500/30 uppercase">Stage 3: 故事文章情境浸泡</span>
                        <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 text-xs leading-relaxed text-slate-200">
                            ${activeWordObj.storySentences.join(' ')}
                        </div>
                        <p class="text-[11px] text-slate-400 bg-purple-950/30 p-3 rounded-xl border border-purple-500/20">
                            ${activeWordObj.storyZh}
                        </p>
                    </div>
                `;
            } else if (currentBrainwashStep === 4) {
                nextBtn.innerHTML = `下一步 <i class="fa-solid fa-chevron-right ml-1"></i>`;
                container.innerHTML = `
                    <div class="space-y-3">
                        <span class="text-[10px] font-bold bg-emerald-500/20 text-emerald-300 px-3 py-1 rounded-full border border-emerald-500/30 uppercase">Stage 4: 多重語速句子重複</span>
                        <div class="space-y-2">
                            ${activeWordObj.sentences.map((s) => `
                                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
                                    <div>
                                        <p class="text-xs font-bold text-white">${s.en}</p>
                                        <p class="text-[10px] text-slate-400">${s.zh}</p>
                                    </div>
                                    <button onclick="speakWord('${s.en.replace(/'/g, "\\'")}')" class="text-purple-400 p-1">
                                        <i class="fa-solid fa-volume-high text-xs"></i>
                                    </button>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } else if (currentBrainwashStep === 5) {
                nextBtn.innerHTML = `完成洗腦 <i class="fa-solid fa-check ml-1"></i>`;
                triggerConfetti();
                container.innerHTML = `
                    <div class="text-center py-4 space-y-3">
                        <div class="w-16 h-16 bg-gradient-to-tr from-emerald-500 to-teal-400 text-white rounded-full flex items-center justify-center mx-auto text-2xl shadow-xl shadow-emerald-500/20">
                            <i class="fa-solid fa-award"></i>
                        </div>
                        <h4 class="text-xl font-black text-white">五感洗腦成功鎖定！</h4>
                        <p class="text-xs text-slate-300">
                            單字 <strong class="text-purple-400">${activeWordObj.word}</strong> 已建立高強度神經記憶連結。
                        </p>
                        <div class="bg-purple-950/40 border border-purple-500/30 p-3 rounded-xl text-xs text-purple-200">
                            連續連擊天數加 1 天！繼續保持！
                        </div>
                    </div>
                `;
                userStreak++;
                localStorage.setItem('wordwave_v2_streak', userStreak);
                document.getElementById('streak-count').textContent = userStreak;
            }
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 80,
                    spread: 60,
                    origin: { y: 0.6 }
                });
            }
        }

        function startCollectionQuiz() {
            const savedWords = wordDatabase.filter(w => bookmarkedWords.includes(w.word));
            if (savedWords.length === 0) {
                showToast('請先收藏單字！');
                return;
            }
            loadDailyWordByIndex(0);
            switchTab('daily');
            startBrainwashSession();
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = message;
            toast.classList.remove('translate-x-full');
            setTimeout(() => {
                toast.classList.add('translate-x-full');
            }, 3000);
        }
    </script>
</body>
</html>
