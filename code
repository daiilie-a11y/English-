<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WordWave - 英文洗腦機 v2.5</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            violet: '#8b5cf6',
                            indigo: '#6366f1',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;
            background: #0f172a;
            color: #f8fafc;
            min-height: 100vh;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Keyword Badge with Interactive Tooltip */
        .highlight-keyword {
            background: linear-gradient(120deg, rgba(139, 92, 246, 0.4) 0%, rgba(99, 102, 241, 0.4) 100%);
            border-bottom: 2px solid #a855f7;
            color: #f3e8ff;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 6px;
            cursor: pointer;
            position: relative;
            display: inline-block;
            transition: all 0.2s ease;
        }
        .highlight-keyword:hover {
            background: rgba(168, 85, 247, 0.7);
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* Active Sentence Reading Highlight */
        .story-sentence {
            padding: 2px 4px;
            border-radius: 6px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        .story-sentence.active-sentence {
            background-color: rgba(168, 85, 247, 0.25);
            border-left: 3px solid #c084fc;
            color: #ffffff;
            font-weight: 600;
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 15px rgba(139, 92, 246, 0.3); }
            50% { box-shadow: 0 0 30px rgba(139, 92, 246, 0.7); }
        }
        .animate-glow {
            animation: pulse-glow 3s infinite ease-in-out;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen selection:bg-purple-500 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 glass-panel border-b border-slate-800 px-4 py-3">
        <div class="max-w-5xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('daily')">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-purple-600 via-indigo-500 to-pink-500 flex items-center justify-center text-white shadow-lg shadow-purple-500/20">
                    <i class="fa-solid fa-brain text-xl"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg tracking-tight bg-gradient-to-r from-white via-slate-200 to-purple-400 bg-clip-text text-transparent flex items-center gap-2">
                        WordWave <span class="text-[10px] uppercase font-mono tracking-widest bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2 py-0.5 rounded-full">v2.5 語音故事增強</span>
                    </h1>
                    <p class="text-[11px] text-slate-400">圖像 · 影音 · 故事同步朗讀 · 4維記憶網</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold px-3 py-1.5 rounded-full flex items-center gap-1.5">
                    <i class="fa-solid fa-fire text-amber-400 animate-bounce"></i>
                    <span id="streak-count">5</span> 天連擊
                </div>
            </div>
        </div>
    </header>

    <!-- Main App Container -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-6 mb-24">

        <!-- TAB 1: 今日洗腦 (Daily Main Immersive Dashboard) -->
        <section id="tab-daily" class="tab-content space-y-8">
            
            <!-- Action Toolbar & Switcher -->
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div>
                    <span class="text-xs font-mono font-semibold text-purple-400 uppercase tracking-widest">Daily Brainwash Target</span>
                    <h2 class="text-2xl font-black text-white flex items-center gap-2">
                        <i class="fa-solid fa-bolt-lightning text-amber-400"></i> 今日沉浸英文單字
                    </h2>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="navigateWord(-1)" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-medium transition text-slate-300 flex items-center gap-1">
                        <i class="fa-solid fa-chevron-left"></i> 上一個
                    </button>
                    <button onclick="loadRandomDailyWord()" class="px-3.5 py-2 bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-shuffle"></i> 隨機換單字
                    </button>
                    <button onclick="navigateWord(1)" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-xs font-medium transition text-slate-300 flex items-center gap-1">
                        下一個 <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- Master Word Card (Hero Section) -->
            <div class="glass-card rounded-3xl overflow-hidden border border-slate-700/60 shadow-2xl relative">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
                    
                    <!-- Left: High-def Unsplash Visual Container -->
                    <div class="lg:col-span-5 relative min-h-[260px] lg:min-h-[380px] bg-slate-900 overflow-hidden group">
                        <img id="word-image" src="" alt="Word Visual" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-90">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
                        <div class="absolute top-4 left-4 flex gap-2">
                            <span id="word-category-tag" class="text-[11px] font-bold uppercase tracking-wider bg-purple-950/80 backdrop-blur-md text-purple-300 border border-purple-500/40 px-3 py-1 rounded-full">
                                Daily Life
                            </span>
                        </div>
                        <div class="absolute bottom-4 left-4 right-4 text-xs text-slate-300 flex items-center justify-between">
                            <span class="bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded-lg border border-white/10 text-[11px]"><i class="fa-solid fa-image text-purple-400 mr-1"></i> 圖像情境記憶法</span>
                            <button id="daily-bookmark-btn" onclick="toggleCurrentWordBookmark()" class="w-9 h-9 rounded-full bg-slate-900/80 hover:bg-purple-600 border border-white/20 text-white flex items-center justify-center transition">
                                <i class="fa-regular fa-bookmark"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Right: Vocabulary Info & Audio Controls -->
                    <div class="lg:col-span-7 p-6 lg:p-8 flex flex-col justify-between space-y-6">
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <span id="word-pos" class="text-xs font-mono text-slate-400 font-semibold">noun (名詞)</span>
                                <!-- Speech Speed Controls -->
                                <div class="flex items-center bg-slate-800/80 border border-slate-700 rounded-xl p-1 gap-1 text-[11px]">
                                    <span class="text-slate-400 px-1 font-mono">語速</span>
                                    <button onclick="setGlobalSpeed(0.8)" id="speed-0.8" class="speed-btn px-2 py-0.5 rounded-lg text-slate-300 hover:bg-slate-700 transition">0.8x</button>
                                    <button onclick="setGlobalSpeed(1.0)" id="speed-1.0" class="speed-btn px-2 py-0.5 rounded-lg bg-purple-600 text-white font-bold transition">1.0x</button>
                                    <button onclick="setGlobalSpeed(1.2)" id="speed-1.2" class="speed-btn px-2 py-0.5 rounded-lg text-slate-300 hover:bg-slate-700 transition">1.2x</button>
                                </div>
                            </div>

                            <div class="flex items-center gap-4 my-2">
                                <h3 id="current-word" class="text-4xl lg:text-5xl font-black text-white tracking-tight">Apple</h3>
                                <button onclick="speakWord(document.getElementById('current-word').textContent)" class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white flex items-center justify-center shadow-lg shadow-purple-500/30 transition transform active:scale-95">
                                    <i class="fa-solid fa-volume-high text-xl"></i>
                                </button>
                            </div>

                            <div class="flex items-center gap-3 text-slate-400 font-mono text-sm mb-4">
                                <span id="word-phonetic">/ˈæp.əl/</span>
                                <span class="text-slate-600">|</span>
                                <span id="word-translation" class="font-sans font-bold text-xl text-purple-300">蘋果、蘋果公司</span>
                            </div>

                            <p id="word-definition" class="text-sm text-slate-300 leading-relaxed bg-slate-900/50 p-3.5 rounded-2xl border border-slate-800">
                                Definition content
                            </p>
                        </div>

                        <!-- 1-Minute Launch Trigger Banner -->
                        <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="flex items-center gap-2 text-xs text-slate-400">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                                預估 <strong>60 秒</strong> 五感全方位記憶流程
                            </div>
                            <button onclick="startBrainwashSession()" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-purple-600 via-indigo-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-extrabold rounded-2xl shadow-xl shadow-purple-600/30 transition flex items-center justify-center gap-2 text-base animate-glow">
                                <i class="fa-solid fa-bolt"></i> 開啟 1 分鐘極限洗腦
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION 2: 記憶加速器 (Mnemonics & Root Decomposition) -->
            <div class="glass-panel rounded-3xl p-6 border border-purple-500/20 shadow-lg space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-key text-amber-400"></i> 好記憶的方式 (記憶藍圖)
                    </h3>
                    <span class="text-xs bg-amber-500/10 text-amber-400 border border-amber-500/30 px-3 py-1 rounded-full font-mono">Mnemonics</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- 1. Sound-alike / Root breakdown -->
                    <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800">
                        <div class="flex items-center gap-2 text-purple-400 font-bold text-xs uppercase tracking-wider mb-2">
                            <i class="fa-solid fa-puzzle-piece"></i> 諧音 / 字根字首拆解
                        </div>
                        <p id="mnemonic-root" class="text-xs text-slate-300 leading-relaxed">
                            --
                        </p>
                    </div>
                    <!-- 2. Mental Image Prompt -->
                    <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800">
                        <div class="flex items-center gap-2 text-indigo-400 font-bold text-xs uppercase tracking-wider mb-2">
                            <i class="fa-solid fa-eye"></i> 心智圖像聯想
                        </div>
                        <p id="mnemonic-image" class="text-xs text-slate-300 leading-relaxed">
                            --
                        </p>
                    </div>
                    <!-- 3. Contextual Hook Phrase -->
                    <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800">
                        <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs uppercase tracking-wider mb-2">
                            <i class="fa-solid fa-quote-left"></i> 記憶金句
                        </div>
                        <p id="mnemonic-hook" class="text-xs font-bold text-emerald-300 leading-relaxed">
                            --
                        </p>
                    </div>
                </div>
            </div>

            <!-- SECTION 3: 短篇故事小文章 (Mini-Story Context & Native TTS Interactive Player) -->
            <div class="glass-panel rounded-3xl p-6 border border-slate-800 shadow-lg space-y-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-book-open-reader text-purple-400"></i> 情境小故事 (Story Reader & TTS)
                    </h3>
                    <div class="flex items-center gap-2">
                        <button onclick="toggleStoryTranslation()" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1.5 rounded-xl border border-slate-700 transition flex items-center gap-1">
                            <i class="fa-solid fa-language"></i> 中文對照
                        </button>
                    </div>
                </div>

                <!-- Story Audio Player Toolbar -->
                <div class="bg-slate-950/80 p-3.5 rounded-2xl border border-purple-500/30 flex flex-wrap items-center justify-between gap-4">
                    <!-- Play / Pause / Stop Buttons -->
                    <div class="flex items-center gap-2">
                        <button id="story-play-btn" onclick="playStoryTTS()" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold rounded-xl text-xs shadow-md transition flex items-center gap-1.5">
                            <i class="fa-solid fa-play"></i> 播放故事朗讀
                        </button>
                        <button id="story-pause-btn" onclick="pauseStoryTTS()" class="hidden px-3 py-2 bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/30 rounded-xl text-xs font-semibold transition flex items-center gap-1">
                            <i class="fa-solid fa-pause"></i> 暫停
                        </button>
                        <button id="story-stop-btn" onclick="stopStoryTTS()" class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 rounded-xl text-xs font-medium transition flex items-center gap-1">
                            <i class="fa-solid fa-stop"></i> 停止
                        </button>
                    </div>

                    <!-- Story Voice Speed Control -->
                    <div class="flex items-center gap-1.5 bg-slate-900 border border-slate-800 px-2.5 py-1 rounded-xl text-xs">
                        <span class="text-slate-400 font-mono text-[11px]"><i class="fa-solid fa-gauge-high mr-1"></i>故事朗讀語速</span>
                        <button onclick="setStorySpeed(0.8)" id="story-speed-0.8" class="story-speed-btn px-2 py-0.5 rounded-lg text-slate-400 hover:text-white transition">0.8x</button>
                        <button onclick="setStorySpeed(1.0)" id="story-speed-1.0" class="story-speed-btn px-2 py-0.5 rounded-lg bg-purple-600 text-white font-bold transition">1.0x</button>
                        <button onclick="setStorySpeed(1.2)" id="story-speed-1.2" class="story-speed-btn px-2 py-0.5 rounded-lg text-slate-400 hover:text-white transition">1.2x</button>
                    </div>
                </div>

                <!-- Story Text Box with Highlighted Sentences -->
                <div id="story-en-box" class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 text-sm text-slate-200 leading-relaxed font-sans">
                    <!-- Dynamic Story Sentences -->
                </div>
                
                <!-- Story Chinese Translation -->
                <div id="story-zh-box" class="hidden bg-purple-950/20 p-4 rounded-2xl border border-purple-500/20 text-xs text-purple-200 leading-relaxed">
                    <!-- Dynamic Story Translation -->
                </div>
            </div>

            <!-- SECTION 4: 相關影片與影音片段 (Video Clips & Youtube Embeds) -->
            <div class="glass-panel rounded-3xl p-6 border border-slate-800 shadow-lg space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-circle-play text-red-500"></i> 相關單字影片片段 (Video Context)
                    </h3>
                    <span class="text-xs text-slate-400 font-mono">情境影音發音與真實應用</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                    <div class="md:col-span-8 bg-black rounded-2xl overflow-hidden aspect-video relative border border-slate-800 shadow-md">
                        <iframe id="youtube-player" class="w-full h-full" src="" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    </div>
                    <div class="md:col-span-4 space-y-3">
                        <div class="bg-slate-900/80 p-4 rounded-2xl border border-slate-800">
                            <p class="text-xs font-bold text-slate-300 mb-1"><i class="fa-brands fa-youtube text-red-500 mr-1"></i> 影音學習要點：</p>
                            <p id="video-tip" class="text-xs text-slate-400 leading-relaxed">
                                專注聆聽影片中外國人使用該單字的抑揚頓挫與前後搭配詞 (Collocations)。
                            </p>
                        </div>
                        <button onclick="reloadVideo()" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold border border-slate-700 transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-rotate-right"></i> 重播影片片段
                        </button>
                    </div>
                </div>
            </div>

        </section>

        <!-- TAB 2: 探索與切換單字 (Explore Library) -->
        <section id="tab-explore" class="tab-content hidden space-y-6">
            <div>
                <h2 class="text-2xl font-black text-white flex items-center gap-2">
                    <i class="fa-solid fa-compass text-purple-400"></i> 探索與切換單字庫
                </h2>
                <p class="text-xs text-slate-400 mt-1">依類別搜尋或精選情境主題單字</p>
            </div>

            <!-- Search & Filters -->
            <div class="flex flex-col md:flex-row gap-3">
                <div class="relative flex-1">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-slate-500 text-sm"></i>
                    <input type="text" id="search-input" oninput="filterWords()" placeholder="搜尋單字、中文或主題..." class="w-full pl-11 pr-4 py-3 bg-slate-900 border border-slate-800 rounded-2xl text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-purple-500 shadow-inner">
                </div>
                <div id="category-filters" class="flex gap-2 overflow-x-auto pb-1">
                    <button onclick="filterByCategory('all')" class="category-btn active px-4 py-2.5 rounded-2xl text-xs font-bold bg-purple-600 text-white shadow-sm transition whitespace-nowrap">全部</button>
                    <button onclick="filterByCategory('Daily Life')" class="category-btn px-4 py-2.5 rounded-2xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition whitespace-nowrap">生活日常</button>
                    <button onclick="filterByCategory('Business')" class="category-btn px-4 py-2.5 rounded-2xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition whitespace-nowrap">職場商務</button>
                    <button onclick="filterByCategory('Tech')" class="category-btn px-4 py-2.5 rounded-2xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition whitespace-nowrap">科技趨勢</button>
                    <button onclick="filterByCategory('Food & Travel')" class="category-btn px-4 py-2.5 rounded-2xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition whitespace-nowrap">美食旅遊</button>
                </div>
            </div>

            <!-- Explore Cards Grid -->
            <div id="explore-word-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Populated by JS -->
            </div>
        </section>

        <!-- TAB 3: AI 自選主題與單字生成器 (Custom Theme Generator) -->
        <section id="tab-custom" class="tab-content hidden space-y-6">
            <div>
                <h2 class="text-2xl font-black text-white flex items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-purple-400"></i> 自選主題洗腦生成器
                </h2>
                <p class="text-xs text-slate-400 mt-1">輸入您喜愛的興趣或工作領域，即時客製專屬 1 分鐘洗腦模組</p>
            </div>

            <div class="glass-panel rounded-3xl p-6 border border-purple-500/30 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">請輸入您的主題或單字</label>
                    <div class="flex gap-2">
                        <input type="text" id="custom-theme-input" placeholder="例如：健身與重訓、精品咖啡、區塊鏈..." class="flex-1 px-4 py-3 bg-slate-900 border border-slate-800 rounded-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 text-xs text-white">
                        <button onclick="generateCustomTheme()" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold rounded-2xl shadow-lg transition flex items-center gap-2 text-xs whitespace-nowrap">
                            <i class="fa-solid fa-gear"></i> 即時生成包
                        </button>
                    </div>
                </div>

                <div>
                    <p class="text-xs text-slate-500 mb-2">靈感選題：</p>
