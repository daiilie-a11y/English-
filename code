            showToast(`故事朗讀語速設為 ${speed}x`);
        }

        function toggleStoryTranslation() {
            const zhBox = document.getElementById('story-zh-box');
            zhBox.classList.toggle('hidden');
        }

        function playStoryTTS(startFromIndex = 0) {
            if (!('speechSynthesis' in window)) {
                showToast('您的瀏覽器不支援語音合成');
                return;
            }

            if (isStoryPaused) {
                window.speechSynthesis.resume();
                isStoryPaused = false;
                isStoryPlaying = true;
                updateStoryUIState();
                return;
            }

            window.speechSynthesis.cancel();
            const word = wordDatabase[currentWordIndex];
            currentSentenceIdx = startFromIndex;
            isStoryPlaying = true;
            isStoryPaused = false;
            updateStoryUIState();

            speakSentenceSequence(word.storySentences, currentSentenceIdx);
        }

        function speakSentenceSequence(sentences, idx) {
            if (idx >= sentences.length || !isStoryPlaying) {
                stopStoryTTS();
                return;
            }

            currentSentenceIdx = idx;
            highlightStorySentence(idx);

            // Strip HTML tags for SpeechSynthesis
            const cleanText = sentences[idx].replace(/<[^>]*>?/gm, '');
            const utterance = new SpeechSynthesisUtterance(cleanText);
            utterance.lang = 'en-US';
            utterance.rate = storySpeed;

            utterance.onend = function() {
                if (isStoryPlaying && !isStoryPaused) {
                    speakSentenceSequence(sentences, idx + 1);
                }
            };

            utterance.onerror = function() {
                stopStoryTTS();
            };

            window.speechSynthesis.speak(utterance);
        }

        function pauseStoryTTS() {
            if (isStoryPlaying && !isStoryPaused) {
                window.speechSynthesis.pause();
                isStoryPaused = true;
                updateStoryUIState();
            }
        }

        function stopStoryTTS() {
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
